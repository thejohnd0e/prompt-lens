{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-file",
    "opener:default",
    "core:window:allow-current-monitor",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-set-size"
  ]
}
